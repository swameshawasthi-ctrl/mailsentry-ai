# -------------------------------------------------------------
# MAILSENTRY AI - Environment Variables
# -------------------------------------------------------------

# Agentverse Mailbox Configuration
# Put any random words/passphrase for your agent seed
AGENT_SEED="mailsentry-ai-autonomous-security-sentinel-2026"
# Mailbox Key provided by Agentverse when connecting your local agent
AGENT_MAILBOX_KEY=""

# ASI:One / OpenAI Intelligence Credentials
# Get your API key from https://asi1.ai/dashboard/api-keys
ASI1_API_KEY=""
# Default to ASI:One API endpoint (compatible with OpenAI client)
OPENAI_BASE_URL="https://api.asi1.ai/v1"
LLM_MODEL="asi1-mini"
